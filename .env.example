# PostBridge SaaS Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Vision & Multimodal Copywriter Providers (Configure either Gemini or OpenAI)
# Recommended: Google Gemini (Native image & video multimodal analysis, English/Telugu/Hindi)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OpenAI (GPT-4o Vision API)
OPENAI_API_KEY=your_openai_api_key_here

# Meta for Developers (Facebook & Instagram)
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Verified Facebook Page Credentials
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Supabase (Database, Google Auth & Multi-Tenant Workspace)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
